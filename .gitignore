# Large geospatial downloads — fetched via scripts, not committed
data/raw/flood/*
data/raw/facilities/*
data/raw/population_roads/*
!data/raw/flood/.gitkeep
!data/raw/facilities/.gitkeep
!data/raw/population_roads/.gitkeep

data/processed/*
!data/processed/.gitkeep
# ...except small, citable result files (not the large intermediate pickles/rasters)
!data/processed/inequality_per_kabupaten.csv
!data/processed/inequality_summary.csv
!data/processed/penalty_sensitivity_sweep.csv
!data/processed/edge_overlap_sensitivity.csv
!data/processed/leave_one_out_inequality.csv
!data/processed/workforce_denominator_sensitivity.csv
!data/processed/capacity_vs_access_change_scatter.png
!data/processed/null_model_random_edges.csv
!data/processed/kabupaten_capacity_index.geojson
!data/processed/kalsel_facilities_snapped.geojson

# Common geospatial/data formats that belong in raw/ but not in git
*.tif
*.tiff
*.shp
*.shx
*.dbf
*.prj
*.gpkg
*.geojson
*.osm.pbf
# ...except small reference boundaries, worth keeping in git unlike bulk downloads
!data/raw/kalsel_boundary.geojson
!data/raw/kalsel_kabupaten_boundaries.geojson
!data/processed/kabupaten_capacity_index.geojson
!data/processed/kalsel_facilities_snapped.geojson
!data/raw/facilities/kalsel_facilities_complete.geojson
!data/raw/facilities/kalsel_facilities_nodes_only.geojson

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Earthdata / API credentials
.netrc
.env

